# Keep the image to the source only: everything generated is re-created on
# first start (inside the container or on the /data volume).
.git

# the staged Terminal sources local/Dockerfile's stage 2 reads (built here per build):
# excluded from the rest of the context so staging it never re-hashes the engine layers
terminal-src/

# local Python environment (rebuilt in the image)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# setup.py outputs and downloads (engine, packs, models, logs)
/engine/
/build/
/build*/
/dist/
/packs/
/mtp/
/models/
/Strata-data/
# the folders docker/entrypoint.sh creates in a mounted data/ (a link to llama.cpp, the models, the keys): never part of a build (#3644)
/data/install/
/data/state/
/data/home/
/data/Strata-data/
third_party/llama.cpp/
third_party/*.zip
*.done
*.log
strata-*.json
strata-*.txt
run-*.sh
run-*.bat
